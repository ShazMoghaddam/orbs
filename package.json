{
  "name": "@shazmoghaddam/orbs",
  "version": "1.0.3",
  "description": "Ten morphing dot-formation animations on canvas. One file, no dependencies.",
  "main": "orb.js",
  "browser": "orb.min.js",
  "unpkg": "orb.min.js",
  "jsdelivr": "orb.min.js",
  "files": ["orb.js", "orb.min.js"],
  "scripts": {
    "build": "terser orb.js -c -m --comments '/^!/' -o orb.min.js"
  },
